{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build RsiWatcherCLI",
      "command": "dotnet",
      "type": "process",
      "args": [ "build", "${workspaceFolder}/RsiWatcherCLI/RsiWatcherCLI.csproj", "-c", "Debug" ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
    ,
    {
      "label": "build RsiWatcherAvalonia",
      "command": "dotnet",
      "type": "process",
      "args": [ "build", "${workspaceFolder}/RsiWatcherAvalonia/RsiWatcherAvalonia.csproj", "-c", "Debug" ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
    ,
    {
      "label": "build RsiWatcherGUI",
      "command": "dotnet",
      "type": "process",
      "args": [ "build", "${workspaceFolder}/RsiWatcherGUI/RsiWatcherGUI.csproj", "-c", "Debug" ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
  ]
}
