<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RsiWatcherAvalonia"
        x:Class="RsiWatcherAvalonia.MainWindow"
        Width="880" Height="640" Title="RSI Watcher (Avalonia)">
  <Window.Resources>
    <local:BooleanNegationConverter x:Key="Not" />
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

  <!-- Верхняя панель: инструмент, автопередний контракт, secid, опрос, запуск -->
    <StackPanel Orientation="Horizontal">
  <TextBlock VerticalAlignment="Center" Text="Инструмент:"/>
  <ComboBox Width="260" Margin="6,0" ItemsSource="{Binding Instruments}" SelectedItem="{Binding SelectedInstrument}"/>

  <CheckBox Content="Авто-фронт" Margin="8,0" IsChecked="{Binding AutoFront}"/>

  <TextBlock Text="SECID:" Margin="12,0,4,0" VerticalAlignment="Center"/>
      <TextBox Width="100" ToolTip.Tip="Например: SiZ5" IsEnabled="{Binding AutoFront, Converter={StaticResource Not}}" Text="{Binding ManualSecid}"/>

  <TextBlock Text="Интервал опроса (с):" Margin="16,0,4,0" VerticalAlignment="Center"/>
  <TextBox Width="60" Text="{Binding Poll, Mode=TwoWay}"/>

      <Button Width="110" Margin="16,0,0,0" Command="{Binding StartStopCommand}" Content="{Binding StartStopText}" />
    </StackPanel>

    <!-- Timeframe settings -->
    <Border Grid.Row="1" Margin="0,10,0,0" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4">
      <StackPanel>
  <TextBlock Text="Таймфреймы и пороги" FontWeight="Bold" Margin="8,6" />
        <Grid Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

  <TextBlock Grid.Row="0" Grid.Column="0" Text="5 мин" VerticalAlignment="Center"/>
  <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding Use5m, Mode=TwoWay}" Content="Вкл"/>
  <TextBlock Grid.Row="0" Grid.Column="2" Text="Период RSI:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="3" Width="60" Text="{Binding Rsi5, Mode=TwoWay}"/>
  <TextBlock Grid.Row="0" Grid.Column="4" Text="Перекуп./Перепрод." VerticalAlignment="Center"/>
        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal">
          <TextBox Width="60" Text="{Binding Ob5, Mode=TwoWay}"/>
          <TextBox Width="60" Text="{Binding Os5, Mode=TwoWay}"/>
        </StackPanel>

  <TextBlock Grid.Row="1" Grid.Column="0" Text="15 мин" VerticalAlignment="Center"/>
  <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Use15m, Mode=TwoWay}" Content="Вкл"/>
  <TextBlock Grid.Row="1" Grid.Column="2" Text="Период RSI:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="3" Width="60" Text="{Binding Rsi15, Mode=TwoWay}"/>
  <TextBlock Grid.Row="1" Grid.Column="4" Text="Перекуп./Перепрод." VerticalAlignment="Center"/>
        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal">
          <TextBox Width="60" Text="{Binding Ob15, Mode=TwoWay}"/>
          <TextBox Width="60" Text="{Binding Os15, Mode=TwoWay}"/>
        </StackPanel>

  <TextBlock Grid.Row="2" Grid.Column="0" Text="30 мин" VerticalAlignment="Center"/>
  <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding Use30m, Mode=TwoWay}" Content="Вкл"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="RSI period:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="3" Width="60" Text="{Binding Rsi30, Mode=TwoWay}"/>
        <TextBlock Grid.Row="2" Grid.Column="4" Text="OB/OS:" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="2" Grid.Column="5" Orientation="Horizontal">
          <TextBox Width="60" Text="{Binding Ob30, Mode=TwoWay}"/>
          <TextBox Width="60" Text="{Binding Os30, Mode=TwoWay}"/>
        </StackPanel>
      </Grid>
      </StackPanel>
    </Border>

    <!-- Notifications -->
    <Border Grid.Row="2" Margin="0,10,0,8" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4">
      <StackPanel>
        <TextBlock Text="Notifications" FontWeight="Bold" Margin="8,6" />
        <Grid Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

  <TextBlock Grid.Column="0" Text="Токен Telegram-бота:" VerticalAlignment="Center"/>
  <TextBox Grid.Column="1" Name="TgTokenBox" Margin="6,0" Text="{Binding TgToken, Mode=TwoWay}" />

  <TextBlock Grid.Column="0" Margin="0,30,0,0" Text="ID чата Telegram:" VerticalAlignment="Center"/>
  <TextBox Grid.Column="1" Name="TgChatBox" Margin="6,30,0,0" Text="{Binding TgChat, Mode=TwoWay}" />

  <Button Grid.Column="2" Name="TgTestBtn" Content="Тест" Margin="12,0,0,0" Width="90"/>
  <CheckBox Grid.Column="3" Content="Звук" IsChecked="{Binding Beep, Mode=TwoWay}" Margin="16,0,0,0" VerticalAlignment="Center"/>
  <CheckBox Grid.Column="4" Content="Всплыв. уведомл." IsChecked="{Binding Balloon, Mode=TwoWay}" Margin="16,0,0,0" VerticalAlignment="Center"/>
      </Grid>
      </StackPanel>
    </Border>

    <!-- Status + log -->
    <Grid Grid.Row="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Padding="8" Margin="0,0,0,8" Background="#FFF7F7F7" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="6">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Статус:" FontWeight="Bold"/>
          <TextBlock Text="{Binding StatusText}" Margin="6,0"/>
          <TextBlock Text="SECID:" FontWeight="Bold" Margin="20,0,0,0"/>
          <TextBlock Text="{Binding ResolvedSecidText}" Margin="6,0"/>
          <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="RSI 5:" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <Border Background="#FFFFFFFF" BorderBrush="#FFCFCFCF" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,8,0">
              <TextBlock Text="{Binding Rsi5Text}" Foreground="{Binding Rsi5Brush}"/>
            </Border>

            <TextBlock Text="RSI 15:" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <Border Background="#FFFFFFFF" BorderBrush="#FFCFCFCF" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,8,0">
              <TextBlock Text="{Binding Rsi15Text}" Foreground="{Binding Rsi15Brush}"/>
            </Border>

            <TextBlock Text="RSI 30:" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <Border Background="#FFFFFFFF" BorderBrush="#FFCFCFCF" BorderThickness="1" CornerRadius="4" Padding="6">
              <TextBlock Text="{Binding Rsi30Text}" Foreground="{Binding Rsi30Brush}"/>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

            <StackPanel Grid.Row="1">
              <TextBox Name="LogBox" IsVisible="False" AcceptsReturn="True" IsReadOnly="True"/>
              <ListBox ItemsSource="{Binding Logs}" Height="480"/>
            </StackPanel>
    </Grid>
  </Grid>
</Window>
