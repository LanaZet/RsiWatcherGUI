.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# --- .NET / C# build output ---
[Bb]in/
[Oo]bj/
out/
Debug/
Release/
x64/
x86/
[Aa][Rr][Mm]*/
[Ll]ogs/
*.log

# Паблиш/артефакты
app.publish/
publish/
artifacts/
dist/

# --- NuGet ---
packages/
*.nupkg
