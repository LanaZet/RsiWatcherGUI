nCrunchTemp_*
.sonarqube/

# --- User files ---
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# --- Local config / secrets (оставь appsettings.json под контролем) ---
*.local.json
appsettings.Development.json
appsettings.Local.json
*.secret.json
.env
.env.*

# --- Node (если где-то используешь фронт-сборку) ---
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-lock.yaml

# --- Rider / MSBuild caches ---
/.vsconfig
/.ionide

# --- JetBrains profiler dumps ---
*.iTrace
*.iHeap

