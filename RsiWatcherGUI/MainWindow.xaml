<Window x:Class="RsiWatcherGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RsiWatcherGUI"
        Title="RSI Watcher (MOEX Futures)" Height="640" Width="880"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:BooleanNegationConverter x:Key="Not" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель выбора инструмента -->
        <StackPanel Orientation="Horizontal" >
            <TextBlock Text="Инструмент:" VerticalAlignment="Center"/>
            <ComboBox x:Name="InstrumentCombo" Width="260" SelectedIndex="0" VerticalAlignment="Center"
                      SelectedValuePath="Tag" SelectedValue="{Binding InstrumentRoot, Mode=TwoWay}">
                <ComboBoxItem Content="Доллар–рубль (Si)" Tag="Si"/>
                <ComboBoxItem Content="Нефть Brent (BR)"  Tag="BR"/>
                <ComboBoxItem Content="Индекс РТС (RI)"   Tag="RI"/>
                <ComboBoxItem Content="Сбербанк (SBRF)"   Tag="SBRF"/>
                <ComboBoxItem Content="Газпром (GAZR)"    Tag="GAZR"/>
            </ComboBox>

            <CheckBox x:Name="AutoFrontCheck" VerticalAlignment="Center"
                      Content="Авто-контракт (ближайший)" IsChecked="{Binding AutoFront, Mode=TwoWay}"/>

            <TextBlock Text="SECID:" Margin="12,0,4,0" VerticalAlignment="Center"/>
            <TextBox x:Name="ManualSecidBox" Width="100" VerticalAlignment="Center" ToolTip="Например: SiZ5"
                     Text="{Binding ManualSecid, Mode=TwoWay}" IsEnabled="{Binding AutoFront, Converter={StaticResource Not}}"/>

            <TextBlock Text="Опрос (сек):" Margin="16,0,4,0" VerticalAlignment="Center"/>
            <TextBox x:Name="PollBox" Width="60" VerticalAlignment="Center" Text="{Binding Poll, Mode=TwoWay}"/>

            <Button x:Name="StartStopBtn" Width="110" Margin="16,0,0,0" Content="{Binding StartStopText}" Command="{Binding StartStopCommand}"/>
        </StackPanel>

        <!-- Параметры по таймфреймам -->
        <GroupBox Header="Таймфреймы и пороги" Grid.Row="1" Margin="0,10,0,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="5 минут" VerticalAlignment="Center"/>
                <CheckBox x:Name="Use5m" Grid.Row="0" Grid.Column="1" Content="Вкл." IsChecked="{Binding Use5m, Mode=TwoWay}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="RSI период:" VerticalAlignment="Center"/>
                <TextBox x:Name="Rsi5Box" Grid.Row="0" Grid.Column="3" Width="60" Text="{Binding Rsi5, Mode=TwoWay}"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="OB/OS:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" >
                    <TextBox x:Name="Ob5Box" Width="60" Text="{Binding Ob5, Mode=TwoWay}"/>
                    <TextBox x:Name="Os5Box" Width="60" Text="{Binding Os5, Mode=TwoWay}"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="15 минут" VerticalAlignment="Center"/>
                <CheckBox x:Name="Use15m" Grid.Row="1" Grid.Column="1" Content="Вкл." IsChecked="{Binding Use15m, Mode=TwoWay}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="RSI период:" VerticalAlignment="Center"/>
                <TextBox x:Name="Rsi15Box" Grid.Row="1" Grid.Column="3" Width="60" Text="{Binding Rsi15, Mode=TwoWay}"/>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="OB/OS:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" >
                    <TextBox x:Name="Ob15Box" Width="60" Text="{Binding Ob15, Mode=TwoWay}"/>
                    <TextBox x:Name="Os15Box" Width="60" Text="{Binding Os15, Mode=TwoWay}"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="30 минут" VerticalAlignment="Center"/>
                <CheckBox x:Name="Use30m" Grid.Row="2" Grid.Column="1" Content="Вкл." IsChecked="{Binding Use30m, Mode=TwoWay}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="RSI период:" VerticalAlignment="Center"/>
                <TextBox x:Name="Rsi30Box" Grid.Row="2" Grid.Column="3" Width="60" Text="{Binding Rsi30, Mode=TwoWay}"/>
                <TextBlock Grid.Row="2" Grid.Column="4" Text="OB/OS:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="5" Orientation="Horizontal" >
                    <TextBox x:Name="Ob30Box" Width="60" Text="{Binding Ob30, Mode=TwoWay}"/>
                    <TextBox x:Name="Os30Box" Width="60" Text="{Binding Os30, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Telegram и автозапуск -->
        <GroupBox Header="Уведомления и автозапуск" Grid.Row="2" Margin="0,10,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Telegram Bot Token:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TgTokenBox" Margin="6,0" ToolTip="Создайте бота у @BotFather и вставьте токен" Text="{Binding TgToken, Mode=TwoWay}"/>

                <TextBlock Grid.Column="0" Margin="0,30,0,0" Text="Telegram Chat ID:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TgChatBox" Margin="6,30,0,0" ToolTip="Укажите chat_id (можно id лички или группы)" Text="{Binding TgChat, Mode=TwoWay}"/>

                <Button Grid.Column="2" x:Name="TgTestBtn" Content="Тест" Margin="12,0,0,0" Width="90" Command="{Binding TgTestCommand}"/>
                <CheckBox Grid.Column="3" x:Name="BeepCheck" Content="Звук" Margin="16,0,0,0" VerticalAlignment="Center" IsChecked="{Binding Beep, Mode=TwoWay}"/>
                <CheckBox Grid.Column="4" x:Name="BalloonCheck" Content="Балун в трее" Margin="16,0,0,0" VerticalAlignment="Center" IsChecked="{Binding Balloon, Mode=TwoWay}"/>

                <StackPanel Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,36,0,0">
                    <CheckBox x:Name="AutostartCheck" Content="Автозапуск при входе в Windows" Checked="AutostartCheck_Click" Unchecked="AutostartCheck_Click"/>
                    <CheckBox x:Name="StartMinimizedCheck" Content="Старт сразу в трее" Margin="20,0,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Статус + лог -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Padding="8" Margin="0,0,0,8" Background="#FFF7F7F7" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="6">
                <StackPanel Orientation="Horizontal" >
                    <TextBlock Text="Статус:" FontWeight="Bold"/>
                    <TextBlock x:Name="StatusText" Text="Ожидание…"/>
                    <TextBlock Text="SECID:" FontWeight="Bold" Margin="20,0,0,0"/>
                    <TextBlock x:Name="ResolvedSecidText" Text="—"/>
                    <TextBlock Text="RSI 5/15/30:" FontWeight="Bold" Margin="20,0,0,0"/>
                    <TextBlock x:Name="RsiNowText" Text="—"/>
                </StackPanel>
            </Border>

            <TextBox x:Name="LogBox" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/>
        </Grid>
    </Grid>
</Window>
